{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.srcos.ai/v2/SchemaDefinition.json",
  "title": "SchemaDefinition",
  "description": "A named, versioned logical schema composed of EntityFields. Referenced by a Dataset to describe its structure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "specVersion",
    "name",
    "fields"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^urn:srcos:schema:",
      "description": "Stable URN identifier. Pattern: urn:srcos:schema:<local-id>"
    },
    "type": {
      "const": "SchemaDefinition",
      "description": "Discriminator constant — always \"SchemaDefinition\"."
    },
    "specVersion": {
      "type": "string",
      "description": "Spec version of this document, e.g. \"2.0.0\"."
    },
    "name": {
      "type": "string",
      "description": "Human-readable name for this schema (e.g. \"health_obs_v1\")."
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional description of the schema's purpose and the entity it represents."
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "EntityField.json"
      },
      "description": "The ordered list of EntityField descriptors that make up this schema."
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "Link.json"
      },
      "description": "Supplementary hyperlinks."
    },
    "keys": {
      "type": "array",
      "description": "Keys and indexes of this table as SET-IDENTIFIERS: each identifies a set of rows by an attribute set. `rank` = arity (recomputed); a single-attribute key is a `primitive`. A `foreign` key is a Biperpedia-style bipartite line to another entity's key (entity↔entity). Optional + backward-compatible.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "attributes"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "primary",
              "unique",
              "foreign",
              "index"
            ]
          },
          "attributes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "Field names forming the key — the SET that identifies rows (bipartite: this entity ↔ these attributes)."
          },
          "rank": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "Arity = len(attributes). Recomputed by validate_key_bipartite.py."
          },
          "primitive": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "True iff a single-attribute key (an atomic identity primitive). Recomputed."
          },
          "references": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "description": "For a foreign key: the bipartite entity↔entity link to another table's key.",
            "required": [
              "schemaRef",
              "keyName"
            ],
            "properties": {
              "schemaRef": {
                "type": "string",
                "pattern": "^urn:srcos:"
              },
              "keyName": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
